# ─────────────────────────────────────────────────────────────────────────────
# MODEL PROVIDER — pick ONE of the three presets below (uncomment its block).
# All of them speak OpenAI-compatible /chat/completions.
# ─────────────────────────────────────────────────────────────────────────────

# ── PRESET 1 · PORTKEY (your current setup) ──────────────────────────────────
FIRERUN_PROVIDER=portkey
OPENAI_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-4o
PORTKEY_API_KEY=<your-portkey-api-key>
# RECOMMENDED: create a Virtual Key in Portkey (Dashboard → Virtual Keys →
# OpenAI → save). It stores your OpenAI key server-side, so this repo never
# touches it. Then uncomment:
#PORTKEY_VIRTUAL_KEY=openai-vk-...
# (only if passing a RAW provider key instead of a virtual key:)
#PORTKEY_PROVIDER=openai
#OPENAI_API_KEY=sk-...   # the provider key passed through Portkey

# ── PRESET 2 · TRUEFOUNDRY AI GATEWAY ────────────────────────────────────────
# Docs: https://www.truefoundry.com/docs/ai-gateway/quick-start
# 1. Add a Model Account (OpenAI/Anthropic/Bedrock) in the Gateway UI
# 2. Copy the exact Model ID from the Models listing page
# 3. Point OPENAI_MODEL at it (provider-prefixed, e.g. openai/gpt-4o)
#FIRERUN_PROVIDER=truefoundry
#OPENAI_BASE_URL=https://gateway.truefoundry.ai
#OPENAI_MODEL=openai/gpt-4o          # ← exact Model ID from your Gateway
#OPENAI_API_KEY=tfy-...              # ← TrueFoundry API key (Bearer auth)

# ── PRESET 3 · OPENAI DIRECT ─────────────────────────────────────────────────
#FIRERUN_PROVIDER=openai
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o
#OPENAI_API_KEY=sk-...

# ── (Bonus) LOCAL via Ollama — zero cost, fully offline demo fallback ───────
#FIRERUN_PROVIDER=ollama
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_MODEL=llama3.1

# ─────────────────────────────────────────────────────────────────────────────
# THE STAGE
# ─────────────────────────────────────────────────────────────────────────────
PROD_APP_URL=http://localhost:8080
TWIN_APP_URL=http://localhost:8081
PROD_DB_URL=postgres://stage:stage@localhost:5433/stagedb
TWIN_DB_URL=postgres://stage:stage@localhost:5434/stagedb

# Registry-backed deploys (local registry from the-stage compose)
LOCAL_REGISTRY=http://localhost:5555

# ── GATE ─────────────────────────────────────────────────────────────────────
GATE_PORT=7788
FIRERUN_GATE=http
GATE_TIMEOUT_MIN=15
# Slack incoming webhook — gate cards also posted to your demo channel
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ── SANDBOX ──────────────────────────────────────────────────────────────────
FIRERUN_SANDBOX_DIR=.firerun/sandbox
FIRERUN_EXEC_TIMEOUT_MS=30000

# ── AUDIT ────────────────────────────────────────────────────────────────────
FIRERUN_AUDIT_KEY=dev-key-change-me

# Third cluster (infra-move runbook target)
CLUSTER_B_APP_URL=http://localhost:18082
